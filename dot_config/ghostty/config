theme = TokyoNight
maximize = true
font-family = HackGen Console NF
font-size = 12
font-thicken = true
adjust-cell-height = 2

# =========================
# Visual Style
# =========================
background-opacity = 0.92
background-blur = true
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
unfocused-split-opacity = 0.65
minimum-contrast = 1.1

# =========================
# Cursor
# =========================
cursor-style = bar
cursor-style-blink = true
cursor-invert-fg-bg = true

# =========================
# UX
# =========================
mouse-hide-while-typing = true
copy-on-select = clipboard
scrollback-limit = 50000
macos-titlebar-style = native
window-inherit-working-directory = true
shell-integration = detect
confirm-close-surface = false
focus-follows-mouse = false

# =========================
# Quick Terminal
# =========================
quick-terminal-position = right
quick-terminal-screen = main
quick-terminal-animation-duration = 0.2
quick-terminal-autohide = true

# =========================
# Clipboard
# =========================
clipboard-write = allow
clipboard-trim-trailing-spaces = true

# =========================
# Window Management
# =========================
window-new-tab-position = current

# =========================
# Keybindings
# =========================

# ---- Quick Terminal ----
keybind = cmd+shift+t=toggle_quick_terminal

# ---- Config ----
keybind = "ctrl+a>r=reload_config"

# ---- Direct Split ----
# cmd+d のみ（cmd+shift+d は macOS バグで動作不安定なため除外）
keybind = cmd+d=new_split:right

# ---- Direct Navigate (ホームポジションから即移動) ----
keybind = ctrl+h=goto_split:left
keybind = ctrl+l=goto_split:right
keybind = ctrl+k=goto_split:up
keybind = ctrl+j=goto_split:down

# ---- Tabs ----
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

keybind = "ctrl+a>v=new_split:right"
keybind = "ctrl+a>s=new_split:down"
keybind = "ctrl+a>backslash=new_split:right"
keybind = "ctrl+a>minus=new_split:down"

# ---- Pane Navigate ----
keybind = "ctrl+a>h=goto_split:left"
keybind = "ctrl+a>j=goto_split:down"
keybind = "ctrl+a>k=goto_split:up"
keybind = "ctrl+a>l=goto_split:right"

# ---- Pane Resize ----
keybind = "ctrl+a>shift+h=resize_split:left,10"
keybind = "ctrl+a>shift+j=resize_split:down,10"
keybind = "ctrl+a>shift+k=resize_split:up,10"
keybind = "ctrl+a>shift+l=resize_split:right,10"

# ---- Pane Control ----
keybind = "ctrl+a>x=close_surface"
keybind = "ctrl+a>z=toggle_split_zoom"
keybind = "ctrl+a>e=equalize_splits"

# ---- Tabs (tmux windows 相当) ----
keybind = "ctrl+a>c=new_tab"
keybind = "ctrl+a>n=next_tab"
keybind = "ctrl+a>p=previous_tab"
keybind = "ctrl+a>one=goto_tab:1"
keybind = "ctrl+a>two=goto_tab:2"
keybind = "ctrl+a>three=goto_tab:3"
keybind = "ctrl+a>four=goto_tab:4"
keybind = "ctrl+a>five=goto_tab:5"
keybind = "ctrl+a>six=goto_tab:6"
keybind = "ctrl+a>seven=goto_tab:7"
keybind = "ctrl+a>eight=goto_tab:8"
keybind = "ctrl+a>nine=goto_tab:9"

# =========================
# Copy Mode  (Ghostty 1.3.0+ Key Table)
# ctrl+a > [ で入る / q or Escape で出る
# =========================
keybind = "ctrl+a>left_bracket=activate_key_table:copy_mode,sticky"

keybind = copy_mode:q=deactivate_key_table
keybind = copy_mode:escape=deactivate_key_table
keybind = copy_mode:j=scroll_page_down
keybind = copy_mode:k=scroll_page_up
keybind = copy_mode:d=scroll_page_down
keybind = copy_mode:u=scroll_page_up
keybind = copy_mode:g=scroll_to_top
keybind = copy_mode:shift+g=scroll_to_bottom
keybind = copy_mode:y=copy_to_clipboard
